$ make --no-print-directory -C lab4 CPUS=1

mkdir -p build/cpu1/drivers/
riscv64-linux-gnu-gcc -march=rv64imac_zicsr_zifencei -mabi=lp64 -mcmodel=medany -ffreestanding -fno-builtin -nostdlib -nostartfiles -fno-pic -fno-pie -fno-stack-protector -mno-relax -Wall -Wextra -Werror -O2 -g -MMD -MP -Iinclude -DCPUS=1 -c drivers/plic.c -o build/cpu1/drivers/plic.o
riscv64-linux-gnu-ld -T linker.ld -o build/cpu1/kernel.elf build/cpu1/boot/entry.o build/cpu1/trap/context.o build/cpu1/trap/entry.o build/cpu1/trap/user_entry.o build/cpu1/user/image.o build/cpu1/boot/dtb.o build/cpu1/boot/start.o build/cpu1/kernel/bootstate.o build/cpu1/kernel/main.o build/cpu1/kernel/spinlock.o build/cpu1/mm/page.o build/cpu1/mm/user_vm.o build/cpu1/mm/vm.o build/cpu1/trap/trap.o build/cpu1/trap/user_trap.o build/cpu1/drivers/platform.o build/cpu1/drivers/plic.o build/cpu1/drivers/uart.o build/cpu1/proc/process.o build/cpu1/syscall/dispatch.o build/cpu1/monitor/diagnostics.o build/cpu1/monitor/monitor.o build/cpu1/tests/selftest.o build/cpu1/tests/user_memory.o build/cpu1/tests/user_process.o build/cpu1/lib/console.o build/cpu1/lib/memory.o build/cpu1/lib/sbi.o
