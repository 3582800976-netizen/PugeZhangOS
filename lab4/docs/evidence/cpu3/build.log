$ make --no-print-directory -C lab4 CPUS=3

mkdir -p build/cpu3/drivers/
riscv64-linux-gnu-gcc -march=rv64imac_zicsr_zifencei -mabi=lp64 -mcmodel=medany -ffreestanding -fno-builtin -nostdlib -nostartfiles -fno-pic -fno-pie -fno-stack-protector -mno-relax -Wall -Wextra -Werror -O2 -g -MMD -MP -Iinclude -DCPUS=3 -c drivers/plic.c -o build/cpu3/drivers/plic.o
riscv64-linux-gnu-ld -T linker.ld -o build/cpu3/kernel.elf build/cpu3/boot/entry.o build/cpu3/trap/context.o build/cpu3/trap/entry.o build/cpu3/trap/user_entry.o build/cpu3/user/image.o build/cpu3/boot/dtb.o build/cpu3/boot/start.o build/cpu3/kernel/bootstate.o build/cpu3/kernel/main.o build/cpu3/kernel/spinlock.o build/cpu3/mm/page.o build/cpu3/mm/user_vm.o build/cpu3/mm/vm.o build/cpu3/trap/trap.o build/cpu3/trap/user_trap.o build/cpu3/drivers/platform.o build/cpu3/drivers/plic.o build/cpu3/drivers/uart.o build/cpu3/proc/process.o build/cpu3/syscall/dispatch.o build/cpu3/monitor/diagnostics.o build/cpu3/monitor/monitor.o build/cpu3/tests/selftest.o build/cpu3/tests/user_memory.o build/cpu3/tests/user_process.o build/cpu3/lib/console.o build/cpu3/lib/memory.o build/cpu3/lib/sbi.o
