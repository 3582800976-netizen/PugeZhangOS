--- /dev/null
+++ b/src/kernel/audit_lock_probe.c
@@ -0,0 +1,20 @@
+#include "arch/mod.h"
+#include "lib/mod.h"
+#include "lock/mod.h"
+#include "trap/method.h"
+static sleeplock_t probe_lock;
+static int active;
+extern int audit_lock_sleeps;
+void audit_lock_init(void) { sleeplock_init(&probe_lock,"audit"); }
+uint64 audit_lock_call(void) {
+    if (sleeplock_holding(&probe_lock)) return (uint64)-1;
+    sleeplock_acquire(&probe_lock);
+    if (!sleeplock_holding(&probe_lock) || active) panic("audit sleeplock owner");
+    active = 1;
+    timer_wait(5);
+    if (!sleeplock_holding(&probe_lock) || active != 1) panic("audit sleeplock overlap");
+    active = 0;
+    sleeplock_release(&probe_lock);
+    printf("[lock-probe] waits=%d\n", __atomic_load_n(&audit_lock_sleeps,__ATOMIC_RELAXED));
+    return 0;
+}
