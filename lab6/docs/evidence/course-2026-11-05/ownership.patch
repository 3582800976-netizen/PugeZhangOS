 // 进程结构体数组 + 第一个用户进程的指针
 static proc_t proc_list[N_PROC];
+int audit_active[N_PROC];
+int audit_switches;
+int audit_collisions;
 static proc_t *proczero;
 
 // 全局pid + 保护它的锁
@@ -461,7 +464,13 @@
                 p->state = RUNNING;
                 cpu->proc = p;
                 // 进程锁跨 swtch 交接；切回后由调度器释放。
+                if (__atomic_exchange_n(&audit_active[i], 1, __ATOMIC_ACQ_REL)) {
+                    __atomic_add_fetch(&audit_collisions, 1, __ATOMIC_RELAXED);
