--- /dev/null
+++ b/src/kernel/probe.c
@@ -0,0 +1,15 @@
+#include "arch/mod.h"
+#include "lib/mod.h"
+#include "trap/mod.h"
+extern uint64 lab3_timer_count[NCPU];
+extern int lab3_register_probe(void);
+void lab3_probe(void)
+{
+    int id = mycpuid();
+    uint64 before = __atomic_load_n(&lab3_timer_count[id], __ATOMIC_RELAXED);
+    if (id == 0) printf("[timer-start] %d\n", (int)timer_get_ticks());
+    assert(lab3_register_probe(), "register state corrupted");
+    uint64 after = __atomic_load_n(&lab3_timer_count[id], __ATOMIC_RELAXED);
+    assert(after > before, "hart did not receive timer");
+    printf("[timer-end] hart=%d ticks=%d interrupts=%d regs=PASS\n", id, (int)timer_get_ticks(), (int)(after-before));
+}
--- /dev/null
+++ b/src/kernel/register_probe.S
@@ -0,0 +1,33 @@
+# Test trap preservation of representative caller- and callee-saved registers.
+.section .text
+.globl lab3_register_probe
+lab3_register_probe:
+    addi sp,sp,-32
+    sd s0,0(sp)
+    sd s1,8(sp)
+    sd ra,16(sp)
+    li s0,0x13579bdf
+    li s1,0x2468ace0
+    li t0,0x31415926
+    li t1,0x27182818
+    csrr a1,time
+    li a2,3000000
+    add a2,a2,a1
+1:  csrr a1,time
+    bltu a1,a2,1b
+    li a1,0x13579bdf
+    bne s0,a1,2f
+    li a1,0x2468ace0
+    bne s1,a1,2f
+    li a1,0x31415926
+    bne t0,a1,2f
+    li a1,0x27182818
+    bne t1,a1,2f
+    li a0,1
+    j 3f
+2:  li a0,0
+3:  ld s0,0(sp)
+    ld s1,8(sp)
+    ld ra,16(sp)
+    addi sp,sp,32
+    ret
