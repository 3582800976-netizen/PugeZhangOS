$ make --no-print-directory -C lab5 CPUS=3

mkdir -p build/cpu3/user/
riscv64-linux-gnu-gcc -march=rv64imac_zicsr_zifencei -mabi=lp64 -mcmodel=medany -ffreestanding -fno-builtin -nostdlib -nostartfiles -fno-pic -fno-pie -fno-stack-protector -mno-relax -Wall -Wextra -Werror -O2 -g -MMD -MP -Iinclude -DCPUS=3 -Os -msmall-data-limit=0 -c user/first.c -o build/cpu3/user/first.o
riscv64-linux-gnu-ld -T user/linker.ld -o build/cpu3/user/first.elf build/cpu3/user/start.o build/cpu3/user/first.o build/cpu3/user/register_probe.o build/cpu3/user/usys.o
riscv64-linux-gnu-objcopy -O binary --only-section=.text build/cpu3/user/first.elf build/cpu3/user/code.bin
riscv64-linux-gnu-objcopy -O binary --only-section=.data build/cpu3/user/first.elf build/cpu3/user/data.bin
mkdir -p build/cpu3/user/
riscv64-linux-gnu-gcc -march=rv64imac_zicsr_zifencei -mabi=lp64 -mcmodel=medany -ffreestanding -fno-builtin -nostdlib -nostartfiles -fno-pic -fno-pie -fno-stack-protector -mno-relax -Wall -Wextra -Werror -O2 -g -MMD -MP -Iinclude -DCPUS=3 -DUSER_CODE_IMAGE='"build/cpu3/user/code.bin"' \
      -DUSER_DATA_IMAGE='"build/cpu3/user/data.bin"' -c user/image.S -o build/cpu3/user/image.o
mkdir -p build/cpu3/tests/
riscv64-linux-gnu-gcc -march=rv64imac_zicsr_zifencei -mabi=lp64 -mcmodel=medany -ffreestanding -fno-builtin -nostdlib -nostartfiles -fno-pic -fno-pie -fno-stack-protector -mno-relax -Wall -Wextra -Werror -O2 -g -MMD -MP -Iinclude -DCPUS=3 -c tests/user_process.c -o build/cpu3/tests/user_process.o
riscv64-linux-gnu-ld -T linker.ld -o build/cpu3/kernel.elf build/cpu3/boot/entry.o build/cpu3/trap/context.o build/cpu3/trap/entry.o build/cpu3/trap/user_entry.o build/cpu3/user/image.o build/cpu3/boot/dtb.o build/cpu3/boot/start.o build/cpu3/kernel/bootstate.o build/cpu3/kernel/main.o build/cpu3/kernel/spinlock.o build/cpu3/mm/page.o build/cpu3/mm/user_heap.o build/cpu3/mm/user_vm.o build/cpu3/mm/vm.o build/cpu3/trap/trap.o build/cpu3/trap/user_trap.o build/cpu3/drivers/platform.o build/cpu3/drivers/plic.o build/cpu3/drivers/uart.o build/cpu3/proc/process.o build/cpu3/syscall/dispatch.o build/cpu3/syscall/memory.o build/cpu3/monitor/diagnostics.o build/cpu3/monitor/monitor.o build/cpu3/tests/selftest.o build/cpu3/tests/user_heap.o build/cpu3/tests/user_memory.o build/cpu3/tests/user_process.o build/cpu3/lib/console.o build/cpu3/lib/memory.o build/cpu3/lib/sbi.o
